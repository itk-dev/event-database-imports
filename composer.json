{
    "name": "itk-dev/event-database-api-2.0",
    "description": "Aarhus event database 2.0",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "cerbero/json-parser": "^1.0",
        "cuyz/valinor": "^2.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.4",
        "dragonmantank/cron-expression": "^3.3",
        "easycorp/easyadmin-bundle": "^5.0",
        "elasticsearch/elasticsearch": "^8.19",
        "guzzlehttp/guzzle": "^7.7",
        "league/uri": "^7.4",
        "liip/imagine-bundle": "^2.11",
        "nesbot/carbon": "^3.10",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.0",
        "psr/http-message": "^2.0",
        "stof/doctrine-extensions-bundle": "^1.7",
        "symfony/amqp-messenger": "~7.4.0",
        "symfony/asset": "~7.4.0",
        "symfony/cache": "~7.4.0",
        "symfony/console": "~7.4.0",
        "symfony/doctrine-messenger": "~7.4.0",
        "symfony/dom-crawler": "^7.0",
        "symfony/dotenv": "~7.4.0",
        "symfony/expression-language": "~7.4.0",
        "symfony/filesystem": "~7.4.0",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "~7.4.0",
        "symfony/html-sanitizer": "~7.4.0",
        "symfony/http-client": "~7.4.0",
        "symfony/lock": "~7.4.0",
        "symfony/mailer": "~7.4.0",
        "symfony/messenger": "~7.4.0",
        "symfony/monolog-bundle": "^3.8",
        "symfony/property-access": "~7.4.0",
        "symfony/property-info": "~7.4.0",
        "symfony/runtime": "~7.4.0",
        "symfony/scheduler": "~7.4.0",
        "symfony/security-bundle": "~7.4.0",
        "symfony/serializer": "~7.4.0",
        "symfony/string": "~7.4.0",
        "symfony/translation": "~7.4.0",
        "symfony/twig-bundle": "~7.4.0",
        "symfony/validator": "~7.4.0",
        "symfony/yaml": "~7.4.0",
        "symfonycasts/reset-password-bundle": "^1.23",
        "symfonycasts/verify-email-bundle": "^1.16"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8",
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "ergebnis/composer-normalize": "^2.47",
        "ergebnis/phpunit-slow-test-detector": "^2.19",
        "friendsofphp/php-cs-fixer": "^3.85",
        "liip/test-fixtures-bundle": "^3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13",
        "rector/rector": "^2.5",
        "symfony/ai-mate": "^0.10.0",
        "symfony/ai-monolog-mate-extension": "^0.10.0",
        "symfony/ai-symfony-mate-extension": "^0.10.0",
        "symfony/browser-kit": "~7.4.0",
        "symfony/css-selector": "~7.4.0",
        "symfony/maker-bundle": "^1.49",
        "symfony/stopwatch": "^7.3",
        "symfony/web-profiler-bundle": "^7.3",
        "vincentlanglet/twig-cs-fixer": "^4.0",
        "zenstruck/messenger-test": "^1.11"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Mate\\": "mate/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/ai-mate-composer-plugin": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "ai-mate": {
            "extension": false,
            "includes": [
                "mate/config.php"
            ],
            "scan-dirs": [
                "mate/src"
            ]
        },
        "symfony": {
            "allow-contrib": true,
            "docker": false,
            "require": "7.4.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "coding-standards-apply": [
            "PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix"
        ],
        "coding-standards-check": [
            "PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix --dry-run"
        ],
        "elastic-fix-flood": [
            "curl -X PUT \"elasticsearch:9200/_cluster/settings?pretty\" -H 'Content-Type: application/json' -d'\n{\n    \"persistent\": {\n        \"cluster.routing.allocation.disk.watermark.low\": \"90%\",\n        \"cluster.routing.allocation.disk.watermark.low.max_headroom\": \"100MB\",\n        \"cluster.routing.allocation.disk.watermark.high\": \"98%\",\n        \"cluster.routing.allocation.disk.watermark.high.max_headroom\": \"20MB\",\n        \"cluster.routing.allocation.disk.watermark.flood_stage\": \"99%\",\n        \"cluster.routing.allocation.disk.watermark.flood_stage.max_headroom\": \"5MB\",\n        \"cluster.routing.allocation.disk.watermark.flood_stage.frozen\": \"99%\",\n        \"cluster.routing.allocation.disk.watermark.flood_stage.frozen.max_headroom\": \"5MB\"\n    }\n}\n'",
            "curl -X PUT \"elasticsearch:9200/*/_settings?expand_wildcards=all&pretty\" -H 'Content-Type: application/json' -d'\n{\n    \"index.blocks.read_only_allow_delete\": null\n}\n'"
        ],
        "elastic-health": [
            "curl -X GET \"elasticsearch:9200/_cluster/health?wait_for_status=yellow&timeout=50s&pretty\"\n"
        ],
        "psalm": [
            "./vendor/bin/psalm --no-cache"
        ],
        "queues": [
            "bin/console messenger:consume async scheduler_default --failure-limit=1 -vvv"
        ],
        "translations-update": [
            "# We need a translation from en to en (!) (without prefix) to be able to process placeholders in en.",
            "DEFAULT_LOCALE=en bin/console translation:extract --clean --force en --prefix=''",
            "DEFAULT_LOCALE=en bin/console translation:extract --clean --force da",
            "# Mark default translations (prefixed with `__`) as \u201cNeeds work\u201d in Danish translations",
            "sed --in-place='' 's/<target>__/<target state=\"needs-l10n\">__/' translations/*.da.*xlf"
        ]
    }
}
